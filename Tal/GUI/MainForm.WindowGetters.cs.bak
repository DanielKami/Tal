        #region Show Tool Window Helper

        /// <summary>
        /// Pokazuje okno narzędziowe po lewej stronie z jednolitym rozmiarem.
        /// Jeśli już otwarte — aktywuje.
        /// </summary>
        public void ShowToolWindow(DockContent window, string title = null)
        {
            if (window == null || window.IsDisposed) return;

            if (!string.IsNullOrEmpty(title))
                window.Text = title;

            if (window.IsHidden)
            {
                window.Show(_dockPanel, DockState.DockLeft);

                // ⭐ Ustaw szerokość lewego portu (px → proporcja)
                if (this.Width > 0)
                {
                    _dockPanel.DockLeftPortion = DockWindowConfig.DefaultDockPortionPx
                                               / Math.Max(this.Width, 1);
                }
                _dockPanel.Refresh();
            }
            else
            {
                window.Activate();
            }
        }

        #endregion
    }
